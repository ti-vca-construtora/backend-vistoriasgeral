# Node Environment
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Port
PORT=3000

# Pesquisa de satisfacao
PUBLIC_SURVEY_BASE_URL=http://localhost:3010
SATISFACTION_WORKER_ENABLED=true

# Huggy API v3 (modelos HSM aprovados)
# Parametros dos dois modelos: 1=cliente, 2=unidade, 3=data da vistoria, 4=link.
HUGGY_ACCESS_TOKEN=
HUGGY_CHANNEL_UUID=
HUGGY_INITIAL_TEMPLATE_ID=
HUGGY_REMINDER_TEMPLATE_ID=
HUGGY_INSPECTION_REMINDER_TEMPLATE_ID=
HUGGY_DYNAMIC_BUTTONS_ENABLED=false
# Opcional; use quando o token estiver associado a multiplas companies.
HUGGY_COMPANY_ID=
HUGGY_API_BASE_URL=https://api.huggy.app/v3

# Lembrete diario das vistorias do dia seguinte (09:00 em Sao Paulo)
# Mantenha false ate o template Huggy acima estar aprovado.
INSPECTION_REMINDER_ENABLED=false
INSPECTION_REMINDER_CRON=0 0 9 * * *
INSPECTION_REMINDER_TIMEZONE=America/Sao_Paulo
