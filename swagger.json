    "/eligible": {
      "get": {
        "description": "\n      Retorna clientes elegíveis para agendamento de vistoria:\n      - Sem type: Retorna TODOS (new + again)\n      - type=new: Clientes com status LIBERADA que nunca tiveram vistoria\n      - type=again: Clientes com recusa CONCLUÍDA que não reagendaram\n    ",
        "operationId": "EligibleController_findAll",
        "parameters": [
          {
            "name": "type",
            "required": false,
            "in": "query",
            "description": "Tipo de elegibilidade: \"new\" (primeira vistoria), \"again\" (reagendamento) ou omitir para ambos",
            "schema": {
              "enum": [
                "new",
                "again"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EligibleResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar clientes aptos para vistoria",
        "tags": [
          "Eligible"
        ]
      }
    },
